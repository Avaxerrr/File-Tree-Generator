/* Base QSS for modern dark theme */

/* General QWidget styling */
QWidget {
    background-color: #242424;
    color: #e0e0e0;
    font-size: 10pt;
}

/* Menu Bar Styling */
QMenuBar {
    background-color: #242424;
    color: #e0e0e0;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 16px;
    margin: 0px 2px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #302F2F;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background: #2D2D2D;
    color: #D8D8D8;
}

/* QMenu (Dropdown) Styling */
QMenu {
    background-color: #303030;
}

QMenu::item {
    background-color: transparent;
    color: #e0e0e0;
    padding: 6px 24px 6px 24px;
    border-radius: 4px;
    min-width: 160px;
}

QMenu::item:selected {
    background-color: #5a9bd4;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #A0A0A0;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background: #3a3a3a;
    margin: 4px 8px 4px 8px;
}

/* QPushButton styling */
QPushButton {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 6px 12px;
    color: #e0e0e0;
}
QPushButton:hover {
    background-color: #2a2a2a;
    border-color: #5a5a5a;
}
QPushButton:pressed {
    background-color: #3a3a3a;
    border-color: #7a7a7a;
}

/* QLineEdit styling */
QLineEdit {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e0e0e0;
}
QLineEdit:focus {
    border: 1px solid #5a9bd4;
    background-color: #252525;
}

/* QTextEdit styling */
QTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 6px;
    color: #e0e0e0;
}

/* QRadioButton styling */
QRadioButton {
    spacing: 6px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QRadioButton::indicator:checked {
    background-color: #5a9bd4;
    border-radius: 8px;
}

/* QCheckBox styling */
QCheckBox {
    spacing: 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:checked {
    background-color: #5a9bd4;
    border-radius: 5px;
}

/* QGroupBox styling */
QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    margin-top: 1.4em;  /* space for the title */
    padding: 6px 10px 10px 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px;
    left: 7px;
    top: 0.6em;  /* pull up if needed */
    color: #e0e0e0;
    background: #242424;
}

/* QStatusBar styling */
QStatusBar {
    background-color: #1e1e1e;
    color: #a0a0a0;
    border-top: 1px solid #3a3a3a;
}

/* Modern Scrollbar Styling */
QScrollBar:vertical {
    background-color: #1a1a1a;
    width: 8px;
    margin: 0px;
    border: none;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background-color: #1a1a1a;
    height: 8px;
    margin: 0px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #444444;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #5a9bd4;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background-color: #4080b0;
}

/* Hide the arrow buttons */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

/* Hide the scroll corner */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* Specific styling for tree view scrollbar */
QTextEdit QScrollBar:vertical {
    margin-right: 2px;
}

QTextEdit QScrollBar:horizontal {
    margin-bottom: 2px;
}

/* QLabel styling */
QLabel {
    color: #e0e0e0;
}

/* QSplitter styling */
QSplitter::handle {
    image: url(:/resources/3-dots.png);
    background: none;

    height: 4px; /* for horizontal splitter */
}

/* QTabWidget styling (if used) */
QTabWidget::pane {
    border: 1px solid #3a3a3a;
    border-radius: 6px;
}

/* QListWidget styling for exclusion list */
QListWidget {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    alternate-background-color: #252525;
}
QListWidget::item {
    padding: 4px;
    border-radius: 3px;
}
QListWidget::item:selected {
    background-color: #2a5a8c;
}
QListWidget::item:hover {
    background-color: #2d2d2d;
}

/* QComboBox styling */
QComboBox {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e0e0e0;
}
QComboBox:hover {
    background-color: #252525;
    border-color: #5a5a5a;
}
QComboBox:on {
    background-color: #2a2a2a;
    border-color: #5a9bd4;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border-left: none;
}

/* QSpinBox styling */
QSpinBox {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e0e0e0;
}
QSpinBox:hover {
    background-color: #252525;
    border-color: #5a5a5a;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #2a2a2a;
    border: none;
    width: 16px;
    height: 12px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #3a3a3a;
}

/* Title styling for a more prominent header */
MainWindow > QLabel {
    font-size: 14pt;
    font-weight: bold;
    color: #5a9bd4;
}

QSpinBox::up-arrow {
    image: url(:/resources/arrow-up-white.png);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow {
    image: url(:/resources/arrow-down-white.png);
    width: 9px;
    height: 9px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
    margin: 1px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
    margin: 1px;
}
